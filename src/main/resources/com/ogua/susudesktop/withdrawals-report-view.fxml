<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" style="-fx-background-color: -ogua-bg;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ogua.susudesktop.WithdrawalsReportController">
    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="page-title" text="Withdrawals Report"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#exportPdf" styleClass="button-secondary" text="Export PDF"/>
        <Button onAction="#exportCsv" styleClass="button-secondary" text="Export CSV"/>
    </HBox>

    <VBox spacing="10" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="body-text" text="From"/>
            <DatePicker fx:id="fromDate"/>
            <Label styleClass="body-text" text="Until"/>
            <DatePicker fx:id="untilDate"/>
            <Label styleClass="body-text" text="Status"/>
            <ComboBox fx:id="statusFilter" prefWidth="120"/>
            <Button onAction="#refresh" styleClass="button-secondary" text="Apply"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="totalLabel" styleClass="section-title"/>
        </HBox>
    </VBox>

    <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" prefHeight="420" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="dateColumn" prefWidth="140" text="Requested"/>
                <TableColumn fx:id="accountColumn" prefWidth="120" text="Account"/>
                <TableColumn fx:id="customerColumn" prefWidth="150" text="Customer"/>
                <TableColumn fx:id="statusColumn" prefWidth="90" text="Status"/>
                <TableColumn fx:id="requestedByColumn" prefWidth="120" text="Requested By"/>
                <TableColumn fx:id="approvedByColumn" prefWidth="120" text="Approved By"/>
                <TableColumn fx:id="penaltyColumn" prefWidth="90" text="Penalty"/>
                <TableColumn fx:id="amountColumn" prefWidth="110" text="Amount"/>
            </columns>
        </TableView>
        <Label fx:id="statusLabel" styleClass="text-danger" wrapText="true"/>
    </VBox>
</VBox>
