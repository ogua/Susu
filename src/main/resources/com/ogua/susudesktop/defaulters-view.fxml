<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" style="-fx-background-color: -ogua-bg;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ogua.susudesktop.DefaultersController">
    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="page-title" text="Defaulters"/>
        <Button onAction="#refresh" styleClass="button-secondary" text="Refresh"/>
    </HBox>

    <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" prefHeight="420" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="loanNumberColumn" prefWidth="120" text="Loan #"/>
                <TableColumn fx:id="customerColumn" prefWidth="160" text="Customer"/>
                <TableColumn fx:id="phoneColumn" prefWidth="120" text="Phone"/>
                <TableColumn fx:id="agentColumn" prefWidth="140" text="Agent"/>
                <TableColumn fx:id="daysOverdueColumn" prefWidth="110" text="Days Overdue"/>
                <TableColumn fx:id="remainingColumn" prefWidth="120" text="Amount Due"/>
            </columns>
        </TableView>
        <Label fx:id="statusLabel" styleClass="text-danger" wrapText="true"/>
    </VBox>
</VBox>
