<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" style="-fx-background-color: -ogua-bg;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ogua.susudesktop.TrialBalanceController">
    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="page-title" text="Trial Balance"/>
        <Button onAction="#refresh" styleClass="button-secondary" text="Refresh"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#exportPdf" styleClass="button-secondary" text="Export PDF"/>
        <Button onAction="#exportCsv" styleClass="button-secondary" text="Export CSV"/>
    </HBox>

    <VBox spacing="10" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label fx:id="totalDebitsLabel" styleClass="section-title"/>
            <Label fx:id="totalCreditsLabel" styleClass="section-title"/>
            <Label fx:id="balancedLabel" styleClass="section-title"/>
        </HBox>
    </VBox>

    <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" prefHeight="420" styleClass="table-view" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="codeColumn" prefWidth="120" text="Code"/>
                <TableColumn fx:id="nameColumn" prefWidth="220" text="Name"/>
                <TableColumn fx:id="typeColumn" prefWidth="100" text="Type"/>
                <TableColumn fx:id="debitColumn" prefWidth="120" text="Debit"/>
                <TableColumn fx:id="creditColumn" prefWidth="120" text="Credit"/>
            </columns>
        </TableView>
        <Label fx:id="statusLabel" styleClass="text-danger" wrapText="true"/>
    </VBox>
</VBox>
