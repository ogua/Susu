<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: -ogua-bg;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ogua.susudesktop.LoansController">
<VBox spacing="16" style="-fx-background-color: -ogua-bg;">
    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="page-title" text="Loans"/>
        <Button onAction="#refresh" styleClass="button-secondary" text="Refresh"/>
    </HBox>

    <VBox spacing="10" styleClass="card">
        <Label styleClass="section-title" text="Apply for Loan"/>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <TextField fx:id="customerSearchField" promptText="Search customer by name, phone, or code" HBox.hgrow="ALWAYS"/>
            <Button onAction="#onFindCustomer" styleClass="button-secondary" text="Find"/>
            <ComboBox fx:id="customerCombo" prefWidth="220" promptText="Customer"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <ComboBox fx:id="productCombo" prefWidth="200" promptText="Loan product"/>
            <TextField fx:id="amountField" promptText="Amount (GHS)" prefWidth="140"/>
            <Button onAction="#onCheckEligibility" styleClass="button-secondary" text="Check Eligibility"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <TextField fx:id="guarantorNameField" promptText="Guarantor name (optional)" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="guarantorPhoneField" promptText="Guarantor phone (optional)" prefWidth="180"/>
        </HBox>
        <Label fx:id="eligibilityLabel" styleClass="text-muted" wrapText="true"/>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button onAction="#onSubmitApplication" styleClass="button-primary" text="Submit Application"/>
            <Label fx:id="applyStatusLabel" styleClass="text-danger" wrapText="true"/>
        </HBox>
    </VBox>

    <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="section-title" text="All Loans"/>
            <Button fx:id="approveButton" onAction="#onApprove" styleClass="button-secondary" text="Approve"/>
            <Button fx:id="rejectButton" onAction="#onReject" styleClass="button-secondary" text="Reject"/>
            <Button fx:id="disburseButton" onAction="#onDisburse" styleClass="button-secondary" text="Disburse"/>
            <Button fx:id="repayButton" onAction="#onRecordRepayment" styleClass="button-secondary" text="Record Repayment"/>
            <Button fx:id="restructureButton" onAction="#onRestructure" styleClass="button-secondary" text="Restructure"/>
            <Button fx:id="topUpButton" onAction="#onTopUp" styleClass="button-secondary" text="Top Up"/>
        </HBox>
        <TableView fx:id="table" prefHeight="360" styleClass="table-view" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="loanNumberColumn" prefWidth="110" text="Loan #"/>
                <TableColumn fx:id="customerColumn" prefWidth="180" text="Customer"/>
                <TableColumn fx:id="principalColumn" prefWidth="120" text="Principal"/>
                <TableColumn fx:id="outstandingColumn" prefWidth="120" text="Outstanding"/>
                <TableColumn fx:id="statusColumn" prefWidth="100" text="Status"/>
            </columns>
        </TableView>
        <Label fx:id="statusLabel" styleClass="text-danger" wrapText="true"/>
    </VBox>
</VBox>
</ScrollPane>
