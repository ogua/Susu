<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: -ogua-bg;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ogua.susudesktop.LoanGroupsController">
<VBox spacing="16" style="-fx-background-color: -ogua-bg;">
    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="page-title" text="Loan Groups"/>
        <Button onAction="#refresh" styleClass="button-secondary" text="Refresh"/>
    </HBox>

    <VBox spacing="10" styleClass="card">
        <Label styleClass="section-title" text="New Loan Group"/>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <TextField fx:id="nameField" promptText="Name" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="codeField" promptText="Code" prefWidth="120"/>
            <Button onAction="#onCreateGroup" styleClass="button-primary" text="Create"/>
        </HBox>
        <Label fx:id="createStatusLabel" styleClass="text-danger" wrapText="true"/>
    </VBox>

    <VBox spacing="10" styleClass="card">
        <Label styleClass="section-title" text="Add Member (to selected loan group)"/>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <TextField fx:id="customerSearchField" promptText="Search customer" HBox.hgrow="ALWAYS"/>
            <Button onAction="#onFindCustomer" styleClass="button-secondary" text="Find"/>
            <ComboBox fx:id="customerCombo" prefWidth="220" promptText="Customer"/>
            <Button onAction="#onAddMember" styleClass="button-primary" text="Add to Selected Group"/>
        </HBox>
        <Label fx:id="memberStatusLabel" styleClass="text-danger" wrapText="true"/>
    </VBox>

    <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="section-title" text="All Loan Groups"/>
            <Button fx:id="toggleActiveButton" onAction="#onToggleActive" styleClass="button-secondary" text="Deactivate/Reactivate"/>
        </HBox>
        <TableView fx:id="table" prefHeight="220" styleClass="table-view" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameColumn" prefWidth="200" text="Name"/>
                <TableColumn fx:id="codeColumn" prefWidth="120" text="Code"/>
                <TableColumn fx:id="membersCountColumn" prefWidth="100" text="Members"/>
                <TableColumn fx:id="activeColumn" prefWidth="90" text="Active"/>
            </columns>
        </TableView>
        <Label fx:id="statusLabel" styleClass="text-danger" wrapText="true"/>
    </VBox>

    <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="section-title" text="Members of Selected Group"/>
            <Button fx:id="removeMemberButton" onAction="#onRemoveMember" styleClass="button-secondary" text="Remove Selected Member"/>
        </HBox>
        <TableView fx:id="membersTable" prefHeight="180" styleClass="table-view" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="memberNameColumn" prefWidth="220" text="Customer"/>
                <TableColumn fx:id="memberStatusColumn" prefWidth="100" text="Status"/>
                <TableColumn fx:id="memberJoinedColumn" prefWidth="160" text="Joined"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
</ScrollPane>
