<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ogua.susudesktop.MainController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="topbar">
            <ImageView fitHeight="28" fitWidth="28" preserveRatio="true" smooth="true">
                <Image url="@images/susu-logo.png"/>
            </ImageView>
            <Label styleClass="section-title" text="SusuApp Desktop"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="syncStatusLabel" styleClass="text-muted"/>
            <Button fx:id="syncNowButton" onAction="#onSyncNow" styleClass="button-secondary" text="Sync Now"/>
            <Label fx:id="modeLabel" styleClass="text-muted"/>
            <Label fx:id="userLabel" styleClass="body-text"/>
            <Button onAction="#onLogout" styleClass="button-secondary" text="Sign out"/>
        </HBox>
    </top>
    <left>
        <VBox spacing="4" style="-fx-background-color: -ogua-surface; -fx-min-width: 190; -fx-border-color: transparent -ogua-border transparent transparent; -fx-border-width: 0 1 0 0;">
            <padding><Insets bottom="16" left="10" right="10" top="16"/></padding>
            <Button fx:id="navDashboard" maxWidth="Infinity" onAction="#showDashboard" styleClass="nav-button" text="Dashboard"/>
            <Button fx:id="navCustomers" maxWidth="Infinity" onAction="#showCustomers" styleClass="nav-button" text="Customers"/>
            <Button fx:id="navAccounts" maxWidth="Infinity" onAction="#showAccounts" styleClass="nav-button" text="Savings Accounts"/>
            <Button fx:id="navDayClose" maxWidth="Infinity" onAction="#showDayClose" styleClass="nav-button" text="Day Summary"/>
            <Button fx:id="navPayments" maxWidth="Infinity" onAction="#showPayments" styleClass="nav-button" text="Mobile Money Payments"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label fx:id="storageLabel" styleClass="caption" wrapText="true"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: -ogua-bg;"/>
    </center>
</BorderPane>
