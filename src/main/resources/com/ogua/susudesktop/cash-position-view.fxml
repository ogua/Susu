<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" style="-fx-background-color: -ogua-bg;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ogua.susudesktop.CashPositionController">
    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="page-title" text="Cash Position"/>
        <Button onAction="#refresh" styleClass="button-secondary" text="Refresh"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#exportPdf" styleClass="button-secondary" text="Export PDF"/>
        <Button onAction="#exportCsv" styleClass="button-secondary" text="Export CSV"/>
    </HBox>

    <VBox spacing="10" styleClass="card">
        <Label fx:id="totalLabel" styleClass="section-title"/>
    </VBox>

    <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" prefHeight="420" styleClass="table-view" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameColumn" prefWidth="220" text="Account"/>
                <TableColumn fx:id="heldByColumn" prefWidth="140" text="Held By"/>
                <TableColumn fx:id="balanceColumn" prefWidth="140" text="Cash In Hand"/>
            </columns>
        </TableView>
        <Label fx:id="statusLabel" styleClass="text-danger" wrapText="true"/>
    </VBox>
</VBox>
