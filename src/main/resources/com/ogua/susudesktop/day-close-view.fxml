<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background-color: -ogua-bg;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ogua.susudesktop.DayCloseController">
    <VBox spacing="16" style="-fx-background-color: -ogua-bg;">
        <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

        <Label styleClass="page-title" text="Day Summary"/>

        <VBox spacing="10" styleClass="card">
            <Label styleClass="card-title" text="My Day"/>
            <Label fx:id="summaryLabel" styleClass="body-text" wrapText="true"/>

            <Label styleClass="text-muted" text="Cash you are declaring (GHS)"/>
            <TextField fx:id="declaredCashField" promptText="0.00"/>
            <Label styleClass="text-muted" text="Notes (optional)"/>
            <TextArea fx:id="notesField" prefRowCount="2" wrapText="true"/>

            <Label fx:id="submitStatusLabel" styleClass="text-danger" wrapText="true"/>
            <HBox spacing="8">
                <Button onAction="#onSubmit" styleClass="button-primary" text="Submit Day Sheet"/>
                <Button onAction="#refresh" styleClass="button-secondary" text="Refresh"/>
            </HBox>
        </VBox>

        <VBox spacing="10" styleClass="card">
            <Label styleClass="card-title" text="Pending Withdrawals"/>
            <TableView fx:id="withdrawalsTable" prefHeight="220">
                <columns>
                    <TableColumn fx:id="amountColumn" prefWidth="120" text="Amount"/>
                    <TableColumn fx:id="reasonColumn" prefWidth="220" text="Reason"/>
                    <TableColumn fx:id="withdrawalStatusColumn" prefWidth="100" text="Status"/>
                </columns>
            </TableView>
            <HBox spacing="8">
                <Button onAction="#onApprove" styleClass="button-primary" text="Approve"/>
                <Button onAction="#onPay" styleClass="button-secondary" text="Pay"/>
                <Button onAction="#onReject" styleClass="button-danger" text="Reject"/>
            </HBox>
            <Label fx:id="withdrawalStatusLabel" styleClass="text-danger" wrapText="true"/>
        </VBox>
    </VBox>
</ScrollPane>
