<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" style="-fx-background-color: -ogua-bg;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ogua.susudesktop.ProductsController">
    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

    <Label styleClass="page-title" text="Products"/>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="Savings Products">
            <HBox spacing="16">
                <padding><Insets bottom="16" left="0" right="0" top="16"/></padding>
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <TableView fx:id="savingsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="spNameColumn" prefWidth="160" text="Name"/>
                            <TableColumn fx:id="spCodeColumn" prefWidth="80" text="Code"/>
                            <TableColumn fx:id="spTypeColumn" prefWidth="90" text="Type"/>
                            <TableColumn fx:id="spContributionColumn" prefWidth="110" text="Contribution"/>
                            <TableColumn fx:id="spCommissionColumn" prefWidth="190" text="Commission"/>
                            <TableColumn fx:id="spActiveColumn" prefWidth="80" text="Status"/>
                        </columns>
                    </TableView>
                    <HBox spacing="8">
                        <Button fx:id="spToggleButton" onAction="#onToggleSavingsProduct" styleClass="button-secondary" text="Activate / Deactivate"/>
                        <Button onAction="#refresh" styleClass="button-secondary" text="Refresh"/>
                    </HBox>
                    <Label fx:id="spStatusLabel" styleClass="text-danger" wrapText="true"/>
                </VBox>
                <VBox prefWidth="300" spacing="10" styleClass="card">
                    <Label styleClass="card-title" text="New Savings Product"/>
                    <Label styleClass="text-muted" text="Name"/>
                    <TextField fx:id="spNameField"/>
                    <Label styleClass="text-muted" text="Code"/>
                    <TextField fx:id="spCodeField"/>
                    <Label styleClass="text-muted" text="Type"/>
                    <ComboBox fx:id="spTypeCombo" maxWidth="Infinity"/>
                    <Label styleClass="text-muted" text="Contribution (GHS)"/>
                    <TextField fx:id="spContributionField" promptText="5.00"/>
                    <Label styleClass="text-muted" text="Cycle length (days)"/>
                    <TextField fx:id="spCycleDaysField" promptText="31"/>
                    <Label styleClass="text-muted" text="Commission type"/>
                    <ComboBox fx:id="spCommissionTypeCombo" maxWidth="Infinity"/>
                    <Label styleClass="text-muted" text="Commission value (bps or minor units)"/>
                    <TextField fx:id="spCommissionValueField" promptText="0"/>
                    <Button maxWidth="Infinity" onAction="#onCreateSavingsProduct" styleClass="button-primary" text="Save Product"/>
                </VBox>
            </HBox>
        </Tab>
        <Tab text="Loan Products">
            <HBox spacing="16">
                <padding><Insets bottom="16" left="0" right="0" top="16"/></padding>
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <TableView fx:id="loanTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="lpNameColumn" prefWidth="150" text="Name"/>
                            <TableColumn fx:id="lpCodeColumn" prefWidth="80" text="Code"/>
                            <TableColumn fx:id="lpMethodColumn" prefWidth="120" text="Interest Method"/>
                            <TableColumn fx:id="lpRateColumn" prefWidth="100" text="Rate"/>
                            <TableColumn fx:id="lpTermColumn" prefWidth="100" text="Term"/>
                            <TableColumn fx:id="lpRangeColumn" prefWidth="170" text="Amount Range"/>
                            <TableColumn fx:id="lpActiveColumn" prefWidth="80" text="Status"/>
                        </columns>
                    </TableView>
                    <HBox spacing="8">
                        <Button fx:id="lpToggleButton" onAction="#onToggleLoanProduct" styleClass="button-secondary" text="Activate / Deactivate"/>
                        <Button onAction="#refresh" styleClass="button-secondary" text="Refresh"/>
                    </HBox>
                    <Label fx:id="lpStatusLabel" styleClass="text-danger" wrapText="true"/>
                </VBox>
                <VBox prefWidth="300" spacing="10" styleClass="card">
                    <Label styleClass="card-title" text="New Loan Product"/>
                    <Label styleClass="text-muted" text="Name"/>
                    <TextField fx:id="lpNameField"/>
                    <Label styleClass="text-muted" text="Code"/>
                    <TextField fx:id="lpCodeField"/>
                    <Label styleClass="text-muted" text="Interest method"/>
                    <ComboBox fx:id="lpMethodCombo" maxWidth="Infinity"/>
                    <Label styleClass="text-muted" text="Rate per period (bps, e.g. 300 = 3%)"/>
                    <TextField fx:id="lpRateField" promptText="300"/>
                    <Label styleClass="text-muted" text="Term (periods)"/>
                    <TextField fx:id="lpTermField" promptText="3"/>
                    <Label styleClass="text-muted" text="Repayment frequency"/>
                    <ComboBox fx:id="lpFrequencyCombo" maxWidth="Infinity"/>
                    <Label styleClass="text-muted" text="Minimum amount (GHS)"/>
                    <TextField fx:id="lpMinField" promptText="100.00"/>
                    <Label styleClass="text-muted" text="Maximum amount (GHS)"/>
                    <TextField fx:id="lpMaxField" promptText="2000.00"/>
                    <Button maxWidth="Infinity" onAction="#onCreateLoanProduct" styleClass="button-primary" text="Save Product"/>
                </VBox>
            </HBox>
        </Tab>
    </TabPane>
</VBox>
